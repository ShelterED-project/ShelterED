AI_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
MODELS=deepseek-r1
MODEL_EXPLAIN=deepseek-r1
MODEL_FAST=deepseek-r1
MODEL_OCR=rukopys-ocr
LLM_TIMEOUT=12
INTERNAL_KEY=your_secret_internal_key_here
# true — сервіс відповідає заглушками без виклику LLM/OCR (тести, інтеграція backend)
MOCK_LLM=false
