# Скопіюй у .env і заповни. .env не комітиться.

PROFILE=cloud
ENVIRONMENT=dev
# /docs, /redoc, /openapi.json: без змінної — вимкнені в prod, увімкнені деінде; true/false перевизначає.
# API_DOCS_ENABLED=false
# GIT_SHA=

LOG_LEVEL=INFO
# json у проді, text для локальної розробки
LOG_FORMAT=text

# JSON-список доменів PWA (у prod — лише https://, без "*")
CORS_ORIGINS=["http://localhost:5173"]
# Найбільше тіло запиту, байти (крім завантаження медіа з власними лімітами); більше — 413.
MAX_REQUEST_BODY_BYTES=1048576

# HSTS лише для HTTPS-запитів (схема від uvicorn --proxy-headers); у prod увімкнено завжди
HSTS_ENABLED=false
HSTS_MAX_AGE_S=31536000

# Neon: direct endpoint (без -pooler), схема postgresql+asyncpg://, БЕЗ ?sslmode=... у кінці.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<db>
# Для міграцій Alembic — завжди direct.
DATABASE_URL_DIRECT=postgresql+asyncpg://<user>:<password>@<host>/<db>
# true для Neon, false для локальної БД у Docker
DATABASE_SSL=true
# Пул на процес: (DB_POOL_SIZE + DB_MAX_OVERFLOW) × воркери uvicorn має бути нижче за ліміт з'єднань Neon
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Скільки секунд запит чекає на вільне з'єднання пулу, перш ніж отримати помилку
DB_POOL_TIMEOUT_S=10
# Скільки секунд з'єднання може простоювати у відкритій транзакції, доки Postgres його не розірве (0 — без обмеження)
# Передається при підключенні (server_settings); з pooled endpoint (-pooler) не працює й не надсилається
DB_IDLE_IN_TRANSACTION_TIMEOUT_S=60

# Redis для Celery (backend/docker-compose.dev.yml піднімає його на 6380)
REDIS_URL=redis://localhost:6380/0
REDIS_RESULT_URL=redis://localhost:6380/1

# Секрет підпису JWT (обов'язковий, ≥ 32 символи). Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Дозволені redirect_uri для PKCE (точний збіг); порожньо — redirect_uri не приймається.
OAUTH_REDIRECT_URIS=[]

# Медіа: каталог на диску (у Docker — том) і URL-префікс, за яким їх роздає Nginx.
MEDIA_ROOT=media
MEDIA_URL_PREFIX=/media
# Ліміти, байти: відео 30 МБ, зображення 2 МБ, субтитри VTT 200 КБ, пакет класу на день 50 МБ.
MEDIA_MAX_VIDEO_BYTES=31457280
MEDIA_MAX_IMAGE_BYTES=2097152
MEDIA_MAX_SUBTITLES_BYTES=204800
PACK_MAX_DAY_BYTES=52428800

# API тривог alerts.in.ua (https://devs.alerts.in.ua). Порожній токен — опитування вимкнене,
# лишається ручна кнопка «Тривога». Токен не логується.
ALERTS_API_TOKEN=
ALERTS_API_URL=https://api.alerts.in.ua/v1/alerts/active.json
ALERTS_HTTP_TIMEOUT_S=10
# Найбільша відповідь API тривог, байти; більша вважається збоєм джерела (не відбоєм).
ALERTS_MAX_RESPONSE_BYTES=2097152
# Інтервал опитування (Celery beat), с; ліміт API — 8–10 запитів на хвилину з IP.
ALERTS_POLL_INTERVAL_S=30
# Без успішного опитування довше за це, с, → source_available=false у GET /alerts/active.
ALERTS_SOURCE_STALE_S=300
# Забуті ручні тривоги й ручні переклички закриваються автоматично через N год (перевірка
# кожні ALERTS_AUTO_CLOSE_INTERVAL_S с), якщо школу не покриває тривога з API.
ALERTS_MANUAL_MAX_HOURS=6
ALERTS_AUTO_CLOSE_INTERVAL_S=300

# «Рюкзак»: ліміт на 7 днів (пакети + медіа), байти; перевищення лише логується. 200 МБ.
PACK_MAX_WEEK_BYTES=209715200
# Як часто Celery beat перезбирає пакети всіх класів на 7 днів наперед, с.
PACKS_REFRESH_INTERVAL_S=3600

# Синхронізація: поріг «підозрілого» часу пристрою, с (зсув годинника або подія з майбутнього).
# Позначка для вчителя, не блокування.
SYNC_SUSPICIOUS_SKEW_S=300
# Допуск (с) для session_closed: відмітка після закриття переклички з урахуванням зсуву годинника.
SYNC_ROLLCALL_CLOSE_GRACE_S=120

# Кабінети (B14): поріг «склав тест» (%), «вікно закривається» (год), перерахунок агрегатів (с).
STATS_PASS_SCORE=60
STATS_CLOSING_SOON_H=6
STATS_REFRESH_INTERVAL_S=3600
# Відкладений перерахунок класу після синхронізації (с), один в очікуванні на клас.
STATS_CLASS_DEBOUNCE_S=30
# Навчання під час тривог (дашборд адміністрації): перераховуються тривоги за N днів.
STATS_ALERT_LOOKBACK_DAYS=14

# Rate limiting входу: рахуються лише невдалі спроби у вікні RATE_LIMIT_WINDOW_S (с), без
# блокування акаунта; понад ліміт — 429 + Retry-After. Redis БД 2 (0 і 1 — Celery).
# Redis недоступний — вхід дозволено (fail-open), у лог — попередження.
RATE_LIMIT_REDIS_URL=redis://localhost:6380/2
RATE_LIMIT_JOIN_ACCOUNT=10
RATE_LIMIT_JOIN_IP=300
RATE_LIMIT_LOGIN_ACCOUNT=10
RATE_LIMIT_LOGIN_IP=300
# Загальний ліміт на акаунт з усіх IP (перебір зі зміною IP); тимчасовий, не блокування.
RATE_LIMIT_JOIN_ACCOUNT_ALL_IPS=100
RATE_LIMIT_LOGIN_ACCOUNT_ALL_IPS=100
RATE_LIMIT_WINDOW_S=900
# Невдалі коди прив'язки батьків (POST /parent/link) на акаунт батьків і на IP за вікно.
RATE_LIMIT_PARENT_LINK=10
RATE_LIMIT_PARENT_LINK_IP=100
# Добовий ліміт невдалих входів учня на (код класу + ім'я) з усіх IP (перебір PIN зі зміною IP).
RATE_LIMIT_JOIN_ACCOUNT_DAILY=300
RATE_LIMIT_DAILY_WINDOW_S=86400
# Створення нових учнів на пару IP + клас (рахується кожне; весь клас за одним NAT має пройти).
RATE_LIMIT_JOIN_NEW_STUDENTS=40
RATE_LIMIT_JOIN_NEW_STUDENTS_WINDOW_S=900
# Ліміт запитів (рахується кожен): ШІ-репетитор на учня, QR-ретрансляція на вчителя.
RATE_LIMIT_TUTOR=20
RATE_LIMIT_TUTOR_WINDOW_S=600
RATE_LIMIT_QR_RELAY=120
RATE_LIMIT_QR_RELAY_WINDOW_S=600

# Web Push (VAPID). Пару ключів друкує: python -m app.cli gen-vapid (у .env, не в репозиторій).
# SUBJECT — контакт для push-сервісів: mailto:... Порожні ключі — push не надсилаються.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Пристроїв (підписок) на користувача; понад ліміт найдавніші видаляються.
PUSH_MAX_SUBSCRIPTIONS_PER_USER=10
# Дозволені хости push-сервісів (суфікси, JSON-список). Інші endpoint відхиляються з 422.
# PUSH_ALLOWED_HOST_SUFFIXES=["fcm.googleapis.com","push.services.mozilla.com","push.apple.com","notify.windows.com"]

# Демо-дані (python -m app.cli seed): спільний пароль дорослих демо-акаунтів, >= 8 символів.
# Порожньо — пароль генерується й друкується один раз.
SEED_PASSWORD=

# Строки зберігання (дні), docs/data-inventory.md
RETENTION_SYNC_EVENT_DAYS=180
RETENTION_AUTH_DAYS=7
RETENTION_PARENT_LINK_CODE_DAYS=30
RETENTION_WELLBEING_VIEW_LOG_DAYS=365
